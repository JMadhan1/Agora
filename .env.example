# =============================================================================
# ORACLE SENTINEL — Environment Configuration
# Copy this file to .env and fill in all values before running.
# =============================================================================

# --- Arc Testnet ---
# Get your RPC key from https://thecanteenapp.com (Arc Testnet portal)
ARC_RPC_KEY=your_arc_rpc_key_here

# Deployer/operator private key (hex, no 0x prefix) — needs testnet ETH for gas
DEPLOYER_PRIVATE_KEY=your_private_key_here

# --- Circle ---
# Developer Console: https://console.circle.com
CIRCLE_API_KEY=your_circle_api_key_here
# Entity secret for Developer-Controlled Wallets (32-byte hex)
CIRCLE_ENTITY_SECRET=your_entity_secret_here

# --- AI Models ---
# Groq (free tier, ~6000 req/day): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Anthropic (Claude — used for complex reasoning): https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Evidence Sources ---
# NewsAPI.org (free tier — 100 req/day): https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# --- Polymarket ---
# Builder code for Polymarket V2 builder fees (optional — leave empty to skip)
POLYMARKET_BUILDER_CODE=

# --- Deployed Contract Addresses (auto-populated by deploy.ts) ---
ATTESTATION_VAULT_ADDRESS=
BOND_MANAGER_ADDRESS=
SENTINEL_REGISTRY_ADDRESS=

# --- Agent Tuning ---
# How often scouts re-check each market (seconds)
SCOUT_INTERVAL_SECONDS=30
# Deviation threshold that triggers a dispute (0.40 = 40% difference from market)
DISPUTE_DEVIATION_THRESHOLD=0.40
# Minimum confidence to publish an attestation (0.65 = 65%)
JUDGE_CONFIDENCE_THRESHOLD=0.65
# How many markets to monitor simultaneously (Arc Testnet — keep ≤200)
MAX_MARKETS_MONITORED=200
# Idle USDC above this threshold gets deployed to USYC for yield
USYC_DEPLOY_THRESHOLD_USDC=50.0
# USDC bond each agent must post to operate
AGENT_BOND_AMOUNT_USDC=10.0
