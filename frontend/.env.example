# ============================================================
# Oracle Sentinel Frontend — Environment Variables
# Copy this to .env.local for local development
# Add ALL of these in Vercel Dashboard → Settings → Environment Variables
# ============================================================

# Backend API URL — set to Render deployment URL in production
# Local: http://localhost:8000
# Production: https://oracle-sentinel-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
